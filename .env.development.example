# Development Environment Configuration Template
# 
# INSTRUCTIONS:
# 1. Copy this file to .env.development
# 2. Fill in your actual API keys
# 3. NEVER commit .env.development to Git
#
# The .env.development file is already in .gitignore

# App Configuration
VITE_APP_URL=http://localhost:5173

# Supabase Configuration
# Get these from: https://app.supabase.com/project/YOUR_PROJECT/settings/api
VITE_SUPABASE_URL=https://YOUR_PROJECT_ID.supabase.co
VITE_SUPABASE_PUBLISHABLE_KEY=your_supabase_publishable_key_here
SUPABASE_SECRET_KEY=your_supabase_secret_key_here

# Legacy names for backward compatibility (use same values as above)
VITE_SUPABASE_ANON_KEY=your_supabase_publishable_key_here
SUPABASE_SERVICE_ROLE_KEY=your_supabase_secret_key_here

# Development Mode Flag
VITE_NODE_ENV=development

# Pica AI Configuration
# Get from: https://pica.ai/dashboard
VITE_PICA_SECRET_KEY=your_pica_secret_key_here
VITE_PICA_OPENAI_CONNECTION_KEY=your_pica_openai_connection_key_here
VITE_PICA_GEMINI_CONNECTION_KEY=your_pica_gemini_connection_key_here
VITE_PICA_ELEVENLABS_CONNECTION_KEY=your_pica_elevenlabs_connection_key_here

# Zoo.dev CAD API
# Get from: https://zoo.dev/account/api-tokens
VITE_ZOO_API_BASE_URL=https://api.zoo.dev
VITE_ZOO_API_TOKEN=your_zoo_api_token_here

# Google APIs
# Get from: https://console.cloud.google.com/apis/credentials
VITE_GOOGLE_API_KEY=your_google_api_key_here
VITE_GOOGLE_CX=your_google_custom_search_engine_id_here

# ElevenLabs Voice
# Get from: https://elevenlabs.io/app/settings/api-keys
VITE_ELEVENLABS_DEFAULT_VOICE_ID=your_voice_id_here

# Stripe Test Keys (for development)
# Get from: https://dashboard.stripe.com/test/apikeys
STRIPE_PUBLISHABLE_KEY=pk_test_your_stripe_test_publishable_key_here
STRIPE_SECRET_KEY=sk_test_your_stripe_test_secret_key_here
STRIPE_WEBHOOK_SECRET=whsec_your_webhook_secret_here