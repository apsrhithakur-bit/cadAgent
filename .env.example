# AgentiCAD Environment Variables Configuration
# Copy this file to .env and replace placeholder values with your actual keys

# ========================================
# App Configuration
# ========================================
# CRITICAL: Set this to your production domain for proper redirects
# Development: http://localhost:5173
# Production: https://yourdomain.com
VITE_APP_URL=http://localhost:5173

# ========================================
# Supabase Configuration (NEW KEY SYSTEM - Dec 2024)
# ========================================
# Get these from your Supabase project settings
VITE_SUPABASE_URL=https://your-project-id.supabase.co

# NEW: Publishable key (replaces anon key) - safe for client-side
VITE_SUPABASE_PUBLISHABLE_KEY=your_supabase_publishable_key_here

# NEW: Secret key (replaces service_role key) - backend only, keep secure!
SUPABASE_SECRET_KEY=your_supabase_secret_key_here

# Legacy names (use same values as above for backward compatibility)
VITE_SUPABASE_ANON_KEY=your_supabase_publishable_key_here
SUPABASE_SERVICE_ROLE_KEY=your_supabase_secret_key_here

# ========================================
# Stripe Configuration
# ========================================
# Get these from your Stripe dashboard
# For development, use test keys (sk_test_... and pk_test_...)
# For production, use live keys (sk_live_... and pk_live_...)
STRIPE_SECRET_KEY=sk_test_your_stripe_secret_key_here
STRIPE_PUBLISHABLE_KEY=pk_test_your_stripe_publishable_key_here
STRIPE_WEBHOOK_SECRET=whsec_your_stripe_webhook_secret_here

# ========================================
# Pica AI Configuration
# ========================================
# Get these from your Pica AI dashboard (https://pica.ai)
# These enable AI-powered features like prompt enhancement and voice processing
VITE_PICA_SECRET_KEY=your_pica_secret_key_here
VITE_PICA_OPENAI_CONNECTION_KEY=your_pica_openai_connection_key_here
VITE_PICA_GEMINI_CONNECTION_KEY=your_pica_gemini_connection_key_here
VITE_PICA_ELEVENLABS_CONNECTION_KEY=your_pica_elevenlabs_connection_key_here

# ElevenLabs Voice ID for text-to-speech (optional)
VITE_ELEVENLABS_DEFAULT_VOICE_ID=your_elevenlabs_voice_id_here

# ========================================
# Zoo ML-ephant CAD API Configuration
# ========================================
# Get these from Zoo.dev for CAD model generation
VITE_ZOO_API_BASE_URL=https://api.zoo.dev
VITE_ZOO_API_TOKEN=your_zoo_api_token_here

# ========================================
# Google APIs Configuration
# ========================================
# Get these from Google Cloud Console for manufacturer search
# Enable Custom Search API, Places API, and Geocoding API
VITE_GOOGLE_API_KEY=your_google_api_key_here
VITE_GOOGLE_CX=your_google_custom_search_engine_id_here

# ========================================
# Setup Instructions
# ========================================
# 1. Copy this file: cp .env.example .env
# 2. Replace all placeholder values with your actual API keys
# 3. For production deployment, ensure VITE_APP_URL matches your domain
# 4. Never commit your .env file to version control
# 5. Test your configuration with: npm run dev
#
# For detailed setup instructions, see README.md
